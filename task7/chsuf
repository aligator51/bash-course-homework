#!/usr/bin/bash

# Задача 7. Изменение суффикса в именах файлов

if (($# != 3)); then
    echo "Использование: $0 каталог старый_суффикс новый_суффикс"
    exit 1
fi

dir_path=$1
old_suffix=$2
new_suffix=$3

if [[ ! -d "${dir_path}" ]]; then
    echo "Ошибка: ${dir_path} не является каталогом."
    exit 1
fi

if [[ ! "${old_suffix}" =~ ^\.[^./]*$ ]]; then
    echo "Ошибка: неверный старый суффикс."
    exit 1
fi

if [[ ! "${new_suffix}" =~ ^\.[^./]*$ ]]; then
    echo "Ошибка: неверный новый суффикс."
    exit 1
fi

while IFS= read -r -d '' file; do

    filename=${file##*/}

    if [[ "${filename}" != ?*"${old_suffix}" ]]; then
        continue
    fi

    new_name=${filename/%"${old_suffix}"/"${new_suffix}"}

    file_dir=${file%/*}
    new_path="${file_dir}/${new_name}"

    if [[ "${new_path}" == "${file}" ]]; then
        continue
    fi

    if [[ -e "${new_path}" ]]; then
        echo "Ошибка: файл ${new_path} уже существует."
        continue
    fi

    mv -- "${file}" "${new_path}"

done < <(find "${dir_path}" -type f -print0)

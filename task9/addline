#!/usr/bin/bash

# Задача 9. Добавление строки в начало текстового файла Бубеков Д.В. 521

if (($# != 1)); then
    echo "Использование: $0 каталог"
    exit 1
fi

dir_path=$1

if [[ ! -d "${dir_path}" ]]; then
    echo "Ошибка: ${dir_path} не является каталогом."
    exit 1
fi

user_name=$(id -un)
current_date=$(date +%F)

shopt -s nullglob dotglob

for file in "${dir_path}"/*.txt; do

    if [[ ! -f "${file}" || -L "${file}" ]]; then
        continue
    fi

    sed -i "1iApproved ${user_name} ${current_date}" "${file}"

done
